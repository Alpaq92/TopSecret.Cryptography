<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Cross-language parity fuzzing harness for TopSecret.Cryptography.Argon2 — compares its output against an independent Python (argon2-cffi) reference implementation across randomized inputs.</Description>
    <AssemblyTitle>TopSecret.Cryptography.ComparisonHarness</AssemblyTitle>
    <AssemblyName>TopSecret.Cryptography.ComparisonHarness</AssemblyName>
    <PackageId>TopSecret.Cryptography.ComparisonHarness</PackageId>
    <PackageTags>crypto;cryptography;argon2;fuzzing;testing</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TopSecret.Cryptography.Argon2\TopSecret.Cryptography.Argon2.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="README.nuget.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

</Project>
