<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>BenchmarkDotNet performance suite for TopSecret.Cryptography.Argon2 — measures Argon2i/Argon2d/Argon2id throughput across degrees of parallelism and target frameworks.</Description>
    <AssemblyTitle>TopSecret.Cryptography.ArgonBenchmarks</AssemblyTitle>
    <AssemblyName>TopSecret.Cryptography.ArgonBenchmarks</AssemblyName>
    <PackageId>TopSecret.Cryptography.ArgonBenchmarks</PackageId>
    <PackageTags>crypto;cryptography;argon2;benchmark;benchmarkdotnet</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net462;net8.0;net10.0</TargetFrameworks>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="BenchmarkDotNet.Diagnostics.Windows" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TopSecret.Cryptography.Argon2\TopSecret.Cryptography.Argon2.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="README.nuget.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

</Project>
