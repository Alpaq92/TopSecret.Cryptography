<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Internal dev tool, never meant to ship as a NuGet package. Without
         this, `dotnet pack` on the solution packs it anyway (dotnet pack
         defaults every project to packable regardless of OutputType) —
         confirmed live: it shipped to NuGet.org as ComparisonHarness 1.4.3
         before this fix. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TopSecret.Cryptography.Argon2\TopSecret.Cryptography.Argon2.csproj" />
  </ItemGroup>

</Project>
