<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Argon2i, Argon2d, and Argon2id (the Password Hashing Competition winner) for .NET, implemented as a System.Security.Cryptography.DeriveBytes. Maintained fork of Konscious.Security.Cryptography.Argon2.</Description>
    <AssemblyTitle>TopSecret.Cryptography.Argon2</AssemblyTitle>
    <VersionPrefix>1.3.1</VersionPrefix>
    <LangVersion>8.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>TopSecret.Cryptography.Argon2</AssemblyName>
    <OutputType>Library</OutputType>
    <PackageId>TopSecret.Cryptography.Argon2</PackageId>
    <PackageTags>crypto;cryptography;argon2;argon2i;argon2d;argon2id;password</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetFrameworks>netstandard2.0;net462;net6.0;net8.0;net10.0</TargetFrameworks>
    <!-- CI legs on non-Windows runners set CI_TFMS to drop net462 (a Windows-only
         .NET Framework target) so a plain `dotnet build` doesn't need
         cross-compilation reference-assembly assumptions verified. -->
    <TargetFrameworks Condition="'$(CI_TFMS)' != ''">$(CI_TFMS)</TargetFrameworks>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TopSecret.Cryptography.Argon2.Test" Key="$(FriendAssembliesPublicKey)" />
    <InternalsVisibleTo Include="TopSecret.Cryptography.ArgonBenchmarks" Key="$(FriendAssembliesPublicKey)" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
    <!-- NuGet.org doesn't render the GitHub README's HTML badges/divs the
         way GitHub does (they show up as literal tag text) — this package
         ships its own short, plain-markdown readme instead. -->
    <None Include="README.nuget.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
  <!-- Linked (not copied) source: these files are byte-for-byte the same
       algorithm as TopSecret.Cryptography.Blake2's own internal Blake2b
       implementation. Linking means there's exactly one copy on disk, so a
       future fix to the compression function can't fix one project's copy
       and silently miss the other's — a real concern for a security-critical
       primitive. HMACBlake2B.cs is NOT linked here: it's a deliberately
       different, internal-only, trimmed file (see that file's own comment),
       not the same source as the public Blake2 package's HMACBlake2B. -->
  <ItemGroup>
    <Compile Include="..\TopSecret.Cryptography.Blake2\Blake2Constants.cs" Link="Blake2Constants.cs" />
    <Compile Include="..\TopSecret.Cryptography.Blake2\Blake2bBase.cs" Link="Blake2bBase.cs" />
    <Compile Include="..\TopSecret.Cryptography.Blake2\Blake2bNormal.cs" Link="Blake2bNormal.cs" />
    <Compile Include="..\TopSecret.Cryptography.Blake2\Blake2bSimd.cs" Link="Blake2bSimd.cs" />
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'net462' or '$(TargetFramework)' == 'netstandard2.0' ">
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="System.Numerics.Vectors" Version="4.6.1" />
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'net462' ">
    <Reference Include="System" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>
</Project>
