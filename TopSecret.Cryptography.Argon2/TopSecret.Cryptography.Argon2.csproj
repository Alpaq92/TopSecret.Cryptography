<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Argon2i, Argon2d, and Argon2id (the Password Hashing Competition winner) for .NET, implemented as a System.Security.Cryptography.DeriveBytes. Maintained fork of Konscious.Security.Cryptography.Argon2.</Description>
    <AssemblyTitle>TopSecret.Cryptography.Argon2</AssemblyTitle>
    <VersionPrefix>1.3.1</VersionPrefix>
    <LangVersion>8.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>TopSecret.Cryptography.Argon2</AssemblyName>
    <OutputType>Library</OutputType>
    <PackageId>TopSecret.Cryptography.Argon2</PackageId>
    <PackageTags>crypto;cryptography;argon2;argon2i;argon2d;argon2id;password</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetFrameworks>netstandard2.0;net462;net6.0;net8.0;net10.0</TargetFrameworks>
    <!-- CI legs on non-Windows runners set CI_TFMS to drop net462 (a Windows-only
         .NET Framework target) so a plain `dotnet build` doesn't need
         cross-compilation reference-assembly assumptions verified. -->
    <TargetFrameworks Condition="'$(CI_TFMS)' != ''">$(CI_TFMS)</TargetFrameworks>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TopSecret.Cryptography.Argon2.Test" Key="$(FriendAssembliesPublicKey)" />
    <InternalsVisibleTo Include="ArgonBenchmarks" Key="$(FriendAssembliesPublicKey)" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../TopSecret.Cryptography.Blake2/TopSecret.Cryptography.Blake2.csproj" />
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'net462' or '$(TargetFramework)' == 'netstandard2.0' ">
    <PackageReference Include="System.Memory" Version="4.6.3" />
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'net462' ">
    <Reference Include="System" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>
</Project>
