<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>An implementation of Blake2 for .NET that integrates with the standard crypto libraries</Description>
    <AssemblyTitle>TopSecret.Cryptography.Blake2</AssemblyTitle>
    <VersionPrefix>1.1.1</VersionPrefix>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DebugType>portable</DebugType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>TopSecret.Cryptography.Blake2</AssemblyName>
    <OutputType>Library</OutputType>
    <PackageId>TopSecret.Cryptography.Blake2</PackageId>
    <PackageTags>crypto;cryptography;hash;blake2;blake2b</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetFrameworks>netstandard2.0;net462;net6.0;net8.0;net10.0</TargetFrameworks>
    <!-- CI legs on non-Windows runners set CI_TFMS to drop net462 (a Windows-only
         .NET Framework target) so a plain `dotnet build` doesn't need
         cross-compilation reference-assembly assumptions verified. -->
    <TargetFrameworks Condition="'$(CI_TFMS)' != ''">$(CI_TFMS)</TargetFrameworks>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TopSecret.Cryptography.Blake2.Test" Key="$(FriendAssembliesPublicKey)" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'net462' or '$(TargetFramework)' == 'netstandard2.0' ">
    <PackageReference Include="System.Numerics.Vectors" Version="4.6.1" />
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'net462' ">
    <Reference Include="System" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>
</Project>
